{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexGo",
  "version": "1.0.0",
  "identifier": "com.vexlune.codexgo",
  "build": {
    "beforeDevCommand": "pnpm dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodexGo — Vexlune Hub",
        "width": 1220,
        "height": 820,
        "minWidth": 940,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
